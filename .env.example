# =============================================================================
# next-app-note 環境変数テンプレート
#
# 使い方:
#   1. このファイルを `.env` にコピー: `cp .env.example .env`
#   2. 必須項目 (# Required と書かれた行) を埋める
#   3. 機能を有効化する任意項目があればまとめてセットする (片欠け禁止)
#
# Source of Truth:
#   - 検証スキーマ: `src/lib/config/env.ts` (Zod)
#   - ローカル手順: `docs/usages/local-setup.md`
#
# Note:
#   - .env はリポジトリにコミットしない (`.gitignore` で除外済)
#   - secret 系は本番で必ず再生成する
# =============================================================================

# -----------------------------------------------------------------------------
# Node.js 環境
# -----------------------------------------------------------------------------
NODE_ENV="development"

# -----------------------------------------------------------------------------
# ログレベル (Optional)
# -----------------------------------------------------------------------------
# Optional — サーバーログの詳細度。開発時は "debug" 推奨。
# 値: fatal | error | warn | info | debug | trace
LOG_LEVEL="info"

# -----------------------------------------------------------------------------
# Database (Prisma)
# -----------------------------------------------------------------------------
# Required
# PostgreSQL 接続文字列。`docker compose up -d` でローカル DB を起動してから設定する。
# 形式: postgresql://user:password@host:port/dbname?schema=public
DATABASE_URL=postgresql://app:app@localhost:54332/app?schema=public

# -----------------------------------------------------------------------------
# Auth.js v5 認証
# Note: note は Auth.js v5 命名 (AUTH_SECRET / AUTH_URL) に完全移行済み。
# -----------------------------------------------------------------------------
# Required
# セッション暗号化キー。32 文字以上必須。
# 生成: openssl rand -base64 48
AUTH_SECRET=""
# Required
# アプリの公開 URL (開発: http://localhost:3000)
AUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Google OAuth (Optional)
# GOOGLE_CLIENT_ID と GOOGLE_CLIENT_SECRET は両方セットするか、両方未設定にすること。
# 片方だけ設定すると起動時に "Google OAuth keys must be all-set or all-unset" で失敗する。
# 取得: https://console.cloud.google.com/apis/credentials
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# GitHub OAuth (Optional)
# GITHUB_CLIENT_ID と GITHUB_CLIENT_SECRET は両方セットするか、両方未設定にすること。
# 片方だけ設定すると起動時に "GitHub OAuth keys must be all-set or all-unset" で失敗する。
# 取得: https://github.com/settings/developers
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# SMTP メール送信 (Optional)
# SMTP_HOST / SMTP_USER / SMTP_PASSWORD は 3 つすべてセットするか、すべて未設定にすること。
# Gmail: smtp.gmail.com (ポート 587) / Outlook: smtp-mail.outlook.com (ポート 587)
# -----------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
# Optional — 送信元メールアドレス (例: noreply@example.com)
SMTP_FROM_EMAIL=""
# Optional — 送信元表示名 (例: Note)
SMTP_FROM_NAME=""

# -----------------------------------------------------------------------------
# R2 / MinIO オブジェクトストレージ (Optional)
# 本番: Cloudflare R2 の認証情報を設定する。
# ローカル: docker compose up -d で MinIO が起動し、以下のデフォルト値で動作する。
# すべて未設定の場合は画像アップロード機能が無効になる (503 を返す)。
# -----------------------------------------------------------------------------
R2_ACCESS_KEY_ID="minioadmin"
R2_SECRET_ACCESS_KEY="minioadmin"
R2_BUCKET_NAME="app-note"
R2_ENDPOINT="http://localhost:9002"
R2_PUBLIC_URL="http://localhost:9002/app-note"

# -----------------------------------------------------------------------------
# Stripe 決済 (Optional)
#
# ローカル開発: docker compose で起動した stripe-mock を使用する。
#   - stripe-mock はキー検証を行わないため sk_test_* / pk_test_* 形式であれば任意の値で動作する。
#   - STRIPE_MOCK_URL を設定すると Stripe クライアントが自動的にモックに向く。
#   - Webhook テストは Stripe CLI が別途必要 (docs/usages/local-setup.md 参照)。
#
# 本番: Stripe ダッシュボード (https://dashboard.stripe.com) で取得した実際の値に差し替え、
#       STRIPE_MOCK_URL は削除または空欄にすること。
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_mock_local"
STRIPE_WEBHOOK_SECRET="whsec_mock_local_do_not_use_in_production"
STRIPE_BASIC_PRICE_ID="price_mock_basic"
STRIPE_PREMIUM_PRICE_ID="price_mock_premium"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_mock_local"
# ローカルの stripe-mock エンドポイント。本番では削除すること。
STRIPE_MOCK_URL="http://localhost:12111"

# -----------------------------------------------------------------------------
# Public 環境変数 (クライアントバンドルに埋め込まれる)
# NEXT_PUBLIC_ プレフィックス付きの値は そのままブラウザに送信される。
# 秘密情報 (API key の write 権限、DB 接続文字列、署名鍵) を絶対に入れないこと。
# -----------------------------------------------------------------------------
# Optional — アプリの公開 URL (OG 画像・sitemap の絶対 URL に使用)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
